# Flask/Server
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-me

# Database
# For Railway Postgres, DATABASE_URL will be injected automatically in production.
# For local dev, uncomment one of these:
# DATABASE_URL=sqlite:///local.db
# DATABASE_URL=postgresql://user:password@localhost:5432/sirioarabia

# Cloudinary (for attachments)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
